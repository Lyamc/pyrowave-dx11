+void Encoder::Impl::set_dump_dir(const char *directory, const char *vector_name, const char *device_name)
+{
+	if (!directory || !directory[0])
+	{
+		dump_directory.clear();
+		dump_vector.clear();
+		dump_device.clear();
+		abandon_dump();
+		return;
+	}
+	dump_directory = directory;
+	dump_vector = vector_name ? vector_name : "";
+	dump_device = device_name ? device_name : "";
