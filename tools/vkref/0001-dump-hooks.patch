+void Encoder::Impl::dump_hook(int stage, const char *name, const BufferHandle &buf)
+{
+	if (!dump_enabled || dump_dir.empty())
+		return;
+
+	// Barrier to ensure writes are visible before copying.
+	device->barrier(VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+	                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+
+	// Copy buffer contents to host and write to file.
+	auto *data = device->map_host_buffer(buf, MEMORY_ACCESS_READ_BIT);
+	if (!data)
+		return;
+
+	std::string path = dump_dir + "/" + name + ".bin";
+	FILE *f = fopen(path.c_str(), "wb");
+	if (f)
+	{
+		fwrite(data, 1, buf->get_create_info().size, f);
+		fclose(f);
+	}
+}
+
+void Encoder::Impl::dump_hook(int stage, const ImageViewHandle &view)
+{
+	// Image dumping is handled at the driver level.
+	// This stub exists so the encoder compiles; the driver
+	// overrides dump_hook for ImageViewHandle to do proper
+	// image->buffer copy + readback.
+	(void)stage;
+	(void)view;
+}
