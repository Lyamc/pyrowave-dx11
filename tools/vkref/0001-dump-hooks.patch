+bool Encoder::Impl::finish_dump()
+{
+	if (dump_directory.empty() || dump_finished)
+		return true;
+	if (dump_slots.empty())
+		return false;
+
+	mkdir_p(dump_directory);
+
+	struct Written
+	{
+		std::string name;
+		int stage;
+		std::string dtype;
+		int dim0;
+		int dim1;
+		char sha[65];
+	};
+	std::vector<Written> written;
+	written.reserve(dump_slots.size());
+
+	for (auto &slot : dump_slots)
+	{
+		void *mapped = device->map_host_buffer(*slot.host, MEMORY_ACCESS_READ_BIT, 0, slot.bytes);
+		if (!mapped)
+			return false;
+
+		std::vector<uint8_t> file_bytes;
+		if (slot.widen_f16)
+		{
+			size_t count = size_t(slot.bytes / 2);
+			file_bytes.resize(count * sizeof(float));
+			auto *src = static_cast<const uint16_t *>(mapped);
+			auto *dst = reinterpret_cast<float *>(file_bytes.data());
+			for (size_t i = 0; i < count; i++)
+				dst[i] = half_to_float(src[i]);
+		}
+		else
+		{
+			file_bytes.resize(size_t(slot.bytes));
+			memcpy(file_bytes.data(), mapped, size_t(slot.bytes));
+		}
+		device->unmap_host_buffer(*slot.host, MEMORY_ACCESS_READ_BIT, 0, slot.bytes);
+
+		std::string path = dump_directory;
+		if (!path.empty() && path.back() != '/' && path.back() != '\\')
+			path.push_back('/');
+		path += slot.name;
+		path += ".bin";
+
+		FILE *fp = fopen(path.c_str(), "wb");
+		if (!fp)
+			return false;
+		size_t wrote = fwrite(file_bytes.data(), 1, file_bytes.size(), fp);
+		fclose(fp);
+		if (wrote != file_bytes.size())
+			return false;
+
+		Written item;
+		item.name = slot.name;
+		item.stage = slot.stage;
+		item.dtype = slot.dtype;
+		item.dim0 = slot.dim0;
+		item.dim1 = slot.dim1;
+		sha256_hex(file_bytes.data(), file_bytes.size(), item.sha);
+		written.push_back(std::move(item));
+	}
+
+	std::string manifest_path = dump_directory;
+	if (!manifest_path.empty() && manifest_path.back() != '/' && manifest_path.back() != '\\')
+		manifest_path.push_back('/');
+	manifest_path += "manifest.json";
+
+	FILE *mf = fopen(manifest_path.c_str(), "wb");
+	if (!mf)
+		return false;
+	fprintf(mf, "{\n");
+	fprintf(mf, "  \"vector\": \"");
+	json_escape(mf, dump_vector);
+	fprintf(mf, "\",\n");
+	fprintf(mf, "  \"W\": %d,\n", width);
+	fprintf(mf, "  \"H\": %d,\n", height);
+	fprintf(mf, "  \"budget\": %llu,\n", static_cast<unsigned long long>(dump_budget));
+	fprintf(mf, "  \"sequence\": %u,\n", sequence_count);
+	fprintf(mf, "  \"device\": \"");
+	json_escape(mf, dump_device);
+	fprintf(mf, "\",\n");
+	fprintf(mf, "  \"ref\": \"a0d2e71+vkref\",\n");
+	fprintf(mf, "  \"buffers\": [\n");
+	for (size_t i = 0; i < written.size(); i++)
+	{
+		const Written &item = written[i];
+		fprintf(mf, "    {\"name\": \"%s\", \"stage\": %d, \"dtype\": \"%s\", \"shape\": [",
+		        item.name.c_str(), item.stage, item.dtype.c_str());
+		if (item.dim1 < 0)
+			fprintf(mf, "%d", item.dim0);
+		else
+			fprintf(mf, "%d, %d", item.dim0, item.dim1);
+		fprintf(mf, "], \"file\": \"%s.bin\", \"sha256\": \"%s\"}",
+		        item.name.c_str(), item.sha);
+		if (i + 1 != written.size())
+			fputc(',', mf);
+		fputc('\n', mf);
+	}
+	fprintf(mf, "  ]\n}\n");
+	fclose(mf);
+
+	dump_finished = true;
+	return true;
+}
