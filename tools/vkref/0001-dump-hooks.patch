+bool Encoder::Impl::dump_bands(CommandBuffer &cmd)
+{
+	if (dump_directory.empty())
+		return true;
+
+	// VALIDATION §3.2: one full barrier, then a host copy of every band layer.
+	cmd.full_barrier();
+	for (int component = 0; component < NumComponents; component++)
+	{
+		for (int level = 0; level < DecompositionLevels; level++)
+		{
+			const ImageView &view = *component_layer_views[component][level];
+			unsigned band_w = view.get_view_width();
+			unsigned band_h = view.get_view_height();
+			bool f16 = view.get_format() == VK_FORMAT_R16_SFLOAT;
+			VkDeviceSize texel = f16 ? 2 : 4;
+			for (int band = 0; band < NumFrequencyBandsPerLevel; band++)
+			{
+				char name[64];
+				snprintf(name, sizeof(name), "band_c%d_l%d_b%d", component, level, band);
+
+				BufferCreateInfo info = {};
+				info.domain = BufferDomain::CachedHost;
+				info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+				info.size = texel * band_w * band_h;
+				BufferHandle host = device->create_buffer(info);
+				if (!host)
+					return false;
+
+				VkImageSubresourceLayers sub = {};
+				sub.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+				sub.mipLevel = view.get_create_info().base_level;
+				sub.baseArrayLayer = view.get_create_info().base_layer + unsigned(band);
+				sub.layerCount = 1;
+				VkOffset3D image_offset = { 0, 0, 0 };
+				VkExtent3D image_extent = { band_w, band_h, 1 };
+				cmd.copy_image_to_buffer(*host, view.get_image(), 0, image_offset, image_extent, 0, 0, sub);
+
+				DumpSlot slot;
+				slot.name = name;
+				slot.stage = 1;
+				slot.dtype = "f32";
+				slot.dim0 = int(band_h);
+				slot.dim1 = int(band_w);
+				slot.host = std::move(host);
+				slot.bytes = info.size;
+				slot.widen_f16 = f16;
+				dump_slots.push_back(std::move(slot));
+			}
+		}
+	}
+	return true;
 }
 
+bool Encoder::Impl::dump_after_quant(CommandBuffer &cmd)
+{
+	if (dump_directory.empty())
+		return true;
+	cmd.full_barrier();
+	if (!dump_copy_buffer(cmd, 2, "meta-buffer", *meta_buffer, 0, meta_buffer->get_create_info().size))
+		return false;
+	if (!dump_copy_buffer(cmd, 2, "block-stat-buffer", *block_stat_buffer, 0, block_stat_buffer->get_create_info().size))
+		return false;
+	if (!dump_copy_buffer(cmd, 2, "payload-data", *payload_data, 0, payload_data->get_create_info().size))
+		return false;
+	return true;
+}
+
+bool Encoder::Impl::dump_bucket(CommandBuffer &cmd)
+{
+	if (dump_directory.empty())
+		return true;
+	cmd.full_barrier();
+	return dump_copy_buffer(cmd, 3, "bucket-buffer", *bucket_buffer, 0, bucket_buffer->get_create_info().size);
+}
+
+bool Encoder::Impl::dump_quant_buffer(CommandBuffer &cmd)
+{
+	if (dump_directory.empty())
+		return true;
+	cmd.full_barrier();
+	return dump_copy_buffer(cmd, 4, "quant-buffer", *quant_buffer, 0, quant_buffer->get_create_info().size);
+}
+
+bool Encoder::Impl::dump_packed(CommandBuffer &cmd, const BitstreamBuffers &buffers)
+{
+	if (dump_directory.empty())
+		return true;
+	cmd.full_barrier();
+	// Stage 5 is the packed output, distinct from the stage-2 meta-buffer.
+	if (!dump_copy_buffer(cmd, 5, "packed-meta", *buffers.meta.buffer, buffers.meta.offset, buffers.meta.size))
+		return false;
+	if (!dump_copy_buffer(cmd, 5, "bitstream", *buffers.bitstream.buffer, buffers.bitstream.offset, buffers.bitstream.size))
+		return false;
+	return true;
+}
