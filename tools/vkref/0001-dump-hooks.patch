+		uint32_t driver = props.driverVersion;
+		snprintf(device_name, sizeof(device_name), "%s/%u.%u.%u.%u",
+		         props.deviceName,
+		         (driver >> 22) & 0x3ffu,
+		         (driver >> 14) & 0xffu,
+		         (driver >> 6) & 0xffu,
+		         driver & 0x3fu);
+	}
+	else
+	{
+		snprintf(device_name, sizeof(device_name), "%s/%u", props.deviceName, props.driverVersion);
+	}
+	encoder->encoder.set_dump_dir(directory, vector_name ? vector_name : "", device_name);
