+
+void Encoder::Impl::abandon_dump()
+{
+	dump_slots.clear();
+	dump_finished = false;
+}
+
+void Encoder::Impl::barrier_dump_host(CommandBuffer &cmd)
+{
+	if (dump_slots.empty())
+		return;
+	cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+	            VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_HOST_READ_BIT);
+}
+
+bool Encoder::Impl::dump_copy_buffer(CommandBuffer &cmd, int stage, const char *name, const Buffer &src,
+                                     VkDeviceSize offset, VkDeviceSize byte_count)
+{
+	if (dump_directory.empty() || byte_count == 0)
+		return true;
+
+	BufferCreateInfo info = {};
+	info.domain = BufferDomain::CachedHost;
+	info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	info.size = byte_count;
+	BufferHandle host = device->create_buffer(info);
+	if (!host)
+		return false;
+	cmd.copy_buffer(*host, 0, src, offset, byte_count);
+
+	DumpSlot slot;
+	slot.name = name;
+	slot.stage = stage;
+	slot.dtype = "u8";
+	slot.dim0 = shape_len(byte_count);
+	slot.dim1 = -1;
+	slot.host = std::move(host);
+	slot.bytes = byte_count;
+	slot.widen_f16 = false;
+	dump_slots.push_back(std::move(slot));
+	return true;
+}
