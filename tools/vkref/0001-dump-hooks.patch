+void json_escape(FILE *fp, const std::string &text)
+{
+	for (char ch : text)
+	{
+		unsigned char c = static_cast<unsigned char>(ch);
+		if (c == '\\' || c == '"')
+		{
+			fputc('\\', fp);
+			fputc(c, fp);
+		}
+		else if (c < 0x20)
+		{
+			fprintf(fp, "\\u%04x", c);
+		}
+		else
+		{
+			fputc(c, fp);
+		}
+	}
+}
