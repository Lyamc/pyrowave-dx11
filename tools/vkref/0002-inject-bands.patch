+// Round-to-nearest-even f32 -> f16, matching HLSL f32tof16 / _mm_cvtps_ph(NEAREST).
+static uint16_t float_to_half_rtne(float value)
+{
+	uint32_t x;
+	memcpy(&x, &value, sizeof(x));
+	uint32_t sign = (x >> 16) & 0x8000u;
+	uint32_t mant = x & 0x007fffffu;
+	uint32_t exp = (x >> 23) & 0xffu;
+
+	if (exp == 255u)
+	{
+		if (mant == 0)
+			return uint16_t(sign | 0x7c00u);
+		uint32_t nan_mant = mant >> 13;
+		if (nan_mant == 0)
+			nan_mant = 1;
+		return uint16_t(sign | 0x7c00u | nan_mant);
+	}
+	if (exp == 0)
+		return uint16_t(sign);
+
+	int exp_un = int(exp) - 127;
+	if (exp_un > 15)
+		return uint16_t(sign | 0x7c00u);
+	if (exp_un < -14)
+	{
+		uint32_t sig = mant | 0x800000u;
+		int shift = 13 + (-14 - exp_un);
+		if (shift >= 25)
+			return uint16_t(sign);
+		if (shift == 24)
+			return uint16_t(sign | (sig > 0x800000u ? 1u : 0u));
+		uint32_t half = 1u << (shift - 1);
+		uint32_t rem = sig & ((1u << shift) - 1u);
+		uint32_t base = sig >> shift;
+		if (rem > half || (rem == half && (base & 1u)))
+			base++;
+		return uint16_t(sign | base);
+	}
+
+	int new_exp = exp_un + 15;
+	uint32_t rem = mant & 0x1fffu;
+	uint32_t base = mant >> 13;
+	if (rem > 0x1000u || (rem == 0x1000u && (base & 1u)))
+	{
+		base++;
+		if (base == 0x400u)
+		{
+			base = 0;
+			new_exp++;
+			if (new_exp >= 31)
+				return uint16_t(sign | 0x7c00u);
+		}
+	}
+	return uint16_t(sign | (uint32_t(new_exp) << 10) | base);
+}
+
+size_t Encoder::Impl::expected_band_floats() const
+{
+	size_t count = 0;
+	for (int level = 0; level < DecompositionLevels; level++)
+	{
+		int band_w = aligned_width >> (level + 1);
+		int band_h = aligned_height >> (level + 1);
+		if (band_w < 1)
+			band_w = 1;
+		if (band_h < 1)
+			band_h = 1;
+		count += size_t(NumComponents) * size_t(NumFrequencyBandsPerLevel) * size_t(band_w) * size_t(band_h);
+	}
+	return count;
+}
+
+bool Encoder::Impl::encode_bands(CommandBuffer &cmd, const float *bands_f32, size_t count,
+                                 const BitstreamBuffers &buffers)
+{
+	if (!bands_f32 || count != expected_band_floats())
+		return false;
+
+	for (int component = 0; component < NumComponents; component++)
+	{
+		for (int level = 0; level < DecompositionLevels; level++)
+		{
+			const ImageView &view = *component_layer_views[component][level];
+			int band_w = aligned_width >> (level + 1);
+			int band_h = aligned_height >> (level + 1);
+			if (band_w < 1)
+				band_w = 1;
+			if (band_h < 1)
+				band_h = 1;
+			if (int(view.get_view_width()) != band_w || int(view.get_view_height()) != band_h)
+				return false;
+		}
+	}
+
+	// encode() increments before any GPU work. encode_pre_transformed does not.
+	sequence_count = (sequence_count + 1) & SequenceCountMask;
+	if (!dump_directory.empty())
+		reset_dump_slots();
+
+	auto to_transfer = [&](const Image &image) {
+		cmd.image_barrier(image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+		                  VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0,
+		                  VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+	};
+	to_transfer(*wavelet_img_high_res);
+	if (wavelet_img_low_res)
+		to_transfer(*wavelet_img_low_res);
+
+	const float *cursor = bands_f32;
+	for (int component = 0; component < NumComponents; component++)
+	{
+		for (int level = 0; level < DecompositionLevels; level++)
+		{
+			const ImageView &view = *component_layer_views[component][level];
+			unsigned band_w = view.get_view_width();
+			unsigned band_h = view.get_view_height();
+			bool store_f16 = view.get_format() == VK_FORMAT_R16_SFLOAT;
+			for (int band = 0; band < NumFrequencyBandsPerLevel; band++)
+			{
+				VkImageSubresourceLayers sub = {};
+				sub.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+				sub.mipLevel = view.get_create_info().base_level;
+				sub.baseArrayLayer = view.get_create_info().base_layer + unsigned(band);
+				sub.layerCount = 1;
+				VkOffset3D image_offset = { 0, 0, 0 };
+				VkExtent3D image_extent = { band_w, band_h, 1 };
+				void *dst = cmd.update_image(view.get_image(), image_offset, image_extent, band_w, band_h, sub);
+				if (!dst)
+					return false;
+
+				size_t texels = size_t(band_w) * band_h;
+				if (store_f16)
+				{
+					auto *out = static_cast<uint16_t *>(dst);
+					for (size_t i = 0; i < texels; i++)
+						out[i] = float_to_half_rtne(cursor[i]);
+				}
+				else
+				{
+					memcpy(dst, cursor, texels * sizeof(float));
+				}
+				cursor += texels;
+			}
+		}
+	}
+
+	cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+	            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+
+	return encode_pre_transformed(cmd, buffers, -1.0f);
+}
+
+bool Encoder::encode_bands(Vulkan::CommandBuffer &cmd, const float *bands_f32, size_t count,
+                           const BitstreamBuffers &buffers)
+{
+	return impl->encode_bands(cmd, bands_f32, count, buffers);
+}
