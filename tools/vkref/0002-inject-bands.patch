+pyrowave_result
+pyrowave_encoder_encode_bands(pyrowave_encoder encoder, const float *bands_f32, size_t count,
+                              const pyrowave_rate_control *rate_control)
+{
+	Util::set_thread_logging_interface(&null_logger);
+	if (!encoder || !bands_f32 || !rate_control)
+		return PYROWAVE_ERROR_INVALID_ARGUMENT;
+	if (encoder->pyro_device->cmd)
+		return PYROWAVE_ERROR_INVALID_ARGUMENT;
+
+	encoder->device->next_frame_context();
+	return pyrowave_encoder_record_and_submit(
+			encoder, nullptr, nullptr, rate_control,
+			[&](CommandBuffer &cmd, const Encoder::BitstreamBuffers &buffers) {
+				return encoder->encoder.encode_bands(cmd, bands_f32, count, buffers);
+			});
+}
